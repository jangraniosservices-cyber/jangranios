{
  "entities": {
    "SiteSettings": {
      "title": "SiteSettings",
      "description": "Public website branding, homepage banner text, about us details, and contact info.",
      "type": "object",
      "properties": {
        "businessName": { "type": "string", "maxLength": 120 },
        "heroHeading": { "type": "string", "maxLength": 160 },
        "heroSubheading": { "type": "string", "maxLength": 240 },
        "heroImageUrl": { "type": "string", "maxLength": 500 },
        "aboutIntro": { "type": "string", "maxLength": 2000 },
        "phone": { "type": "string", "maxLength": 30 },
        "email": { "type": "string", "maxLength": 120 },
        "address": { "type": "string", "maxLength": 400 },
        "workingHours": { "type": "string", "maxLength": 200 }
      },
      "required": ["businessName", "heroHeading", "heroSubheading"]
    },
    "Course": {
      "title": "Course",
      "description": "NIOS courses and academic guidance services.",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 150 },
        "category": { "type": "string", "maxLength": 80 },
        "description": { "type": "string", "maxLength": 1500 },
        "fee": { "type": "number" },
        "duration": { "type": "string", "maxLength": 80 },
        "active": { "type": "boolean" }
      },
      "required": ["title", "category", "description", "fee", "active"]
    },
    "Announcement": {
      "title": "Announcement",
      "description": "Public NIOS exam dates, admission deadlines, and student notices.",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 200 },
        "summary": { "type": "string", "maxLength": 1000 },
        "category": { "type": "string", "maxLength": 60 },
        "publishedAt": { "type": "string", "maxLength": 40 }
      },
      "required": ["title", "summary", "publishedAt"]
    },
    "GalleryItem": {
      "title": "GalleryItem",
      "description": "Campus and student achievement gallery photographs.",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 160 },
        "imageUrl": { "type": "string", "maxLength": 500 },
        "caption": { "type": "string", "maxLength": 400 }
      },
      "required": ["title", "imageUrl"]
    }
  },
  "firestore": {
    "/site_settings/{settingId}": {
      "schema": { "$ref": "#/entities/SiteSettings" },
      "description": "Public website settings document"
    },
    "/courses/{courseId}": {
      "schema": { "$ref": "#/entities/Course" },
      "description": "Public NIOS courses and services catalog"
    },
    "/announcements/{announcementId}": {
      "schema": { "$ref": "#/entities/Announcement" },
      "description": "Latest NIOS announcements and notifications"
    },
    "/gallery/{galleryId}": {
      "schema": { "$ref": "#/entities/GalleryItem" },
      "description": "Campus and student photo gallery"
    }
  }
}
