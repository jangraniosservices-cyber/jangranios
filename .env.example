# GEMINI_API_KEY: Required for Gemini AI API calls if AI features are enabled.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SESSION_SECRET: Cryptographic secret for signing HTTP-only session cookies.
SESSION_SECRET="change_this_to_a_long_random_secret_string"

# VITE_GOOGLE_MAPS_API_KEY: Google Maps Platform API key for the Contact Us map.
VITE_GOOGLE_MAPS_API_KEY=""

# RAZORPAY_KEY_ID & RAZORPAY_KEY_SECRET: Optional live Razorpay merchant credentials.
# When omitted, the built-in verified UPI / Razorpay Sandbox Checkout handles order verification.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
